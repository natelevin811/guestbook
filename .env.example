# --- FreeWindow environment ---
# Copy to .env (local) or set these in Vercel project settings.

# Public URL of the deployment (used to build the OAuth redirect URI).
PUBLIC_BASE_URL=https://your-app.vercel.app
# Optional explicit override; otherwise derived as PUBLIC_BASE_URL/api/oauth/callback
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/oauth/callback

# Google OAuth client (Cloud Console > Credentials > OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Project Settings > API). SERVICE ROLE key is secret — server-only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key for encrypting refresh tokens at rest:  openssl rand -hex 32
TOKEN_ENC_KEY=

# Telegram bot (talk to @BotFather) and the target group chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional secret you set when registering the webhook (recommended).
TELEGRAM_WEBHOOK_SECRET=

# Protects the cron endpoint. Vercel Cron sends this as a Bearer token.
CRON_SECRET=

# --- tunables (all optional; defaults shown) ---
# GROUP_TIMEZONE=America/New_York
# LOOKAHEAD_DAYS=14
# MIN_DURATION_MINUTES=90
# HANGABLE_HOURS={"0":[[11,22]],"1":[[18,22]],"2":[[18,22]],"3":[[18,22]],"4":[[18,22]],"5":[[18,22]],"6":[[11,22]]}
